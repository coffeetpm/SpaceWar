; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="REFRACT: LOOP"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DisplaySettings="*res://scripts/autoload/display_settings.gd"
ArtDirection="*res://scripts/autoload/art_direction.gd"
BeatManager="*res://scripts/autoload/beat_manager.gd"
BeatConductor="*res://scripts/autoload/beat_conductor.gd"
EmotionFeedback="*res://scripts/autoload/emotion_feedback.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
PlayerRef="*res://scripts/autoload/player_ref.gd"
CombatUtil="*res://scripts/autoload/combat_util.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
UpgradeManager="*res://scripts/upgrades/upgrade_applier.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SynergyManager="*res://scripts/autoload/synergy_manager.gd"
BuildVocabulary="*res://scripts/autoload/build_vocabulary.gd"
RunState="*res://scripts/autoload/run_state.gd"
ThemeManager="*res://scripts/autoload/theme_manager.gd"
VisualLayers="*res://scripts/autoload/visual_layers.gd"
LightLanguage="*res://scripts/autoload/light_language.gd"
NeonStyleManager="*res://scripts/autoload/neon_style_manager.gd"
BulletFactory="*res://scripts/autoload/bullet_factory.gd"
HookLines="*res://scripts/copy/hook_lines.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RefractLoop"

